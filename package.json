{
  "name": "openkartr",
  "version": "0.3.0",
  "description": "Install verified OpenKartr skills for AI coding agents.",
  "type": "module",
  "bin": {
    "openkartr": "bin/openkartr.mjs"
  },
    "files": [
      "bin",
      "adapters",
      "lib",
      "registry",
      "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs && node scripts/security-review.mjs",
    "security:review": "node scripts/security-review.mjs",
    "security:hashes": "node scripts/security-review.mjs --write-hashes",
    "release:verify": "node scripts/security-review.mjs --release",
    "upstream:check": "node scripts/check-upstreams.mjs",
    "candidate:github": "node scripts/import-github-candidate.mjs",
    "prepack": "npm run validate && npm run release:verify && npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "codex",
    "skills",
    "logo-design",
    "svg",
    "root-cause-analysis"
  ],
  "author": "OpenKartr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openkartr/skills.git"
  },
  "bugs": {
    "url": "https://github.com/openkartr/skills/issues"
  },
  "homepage": "https://openkartr.com",
  "engines": {
    "node": ">=18"
  }
}

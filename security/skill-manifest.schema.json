{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkartr.com/schemas/verified-skill-manifest.json",
  "title": "OpenKartr verified skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "distribution", "origin", "license", "review", "permissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "distribution": { "enum": ["openkartr-native", "verified-vendored"] },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamRepository", "upstreamPath", "reviewedCommit", "syncPolicy"],
      "properties": {
        "upstreamRepository": { "type": "string", "format": "uri" },
        "upstreamPath": { "type": "string", "minLength": 1 },
        "reviewedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "syncPolicy": { "enum": ["review-pr", "openkartr-maintained"] }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistributionReviewed", "attributionMarker"],
      "properties": {
        "spdx": { "type": "string", "minLength": 2 },
        "redistributionReviewed": { "const": true },
        "attributionMarker": { "type": "string", "minLength": 2 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "riskTier", "reviewedAt", "reviewers", "contentHash"],
      "properties": {
        "status": { "enum": ["verified", "review-required", "rejected", "revoked"] },
        "riskTier": { "enum": ["low", "medium", "high"] },
        "reviewedAt": { "type": "string", "format": "date" },
        "reviewers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "environment", "executables", "reads", "writes"],
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "array", "items": { "type": "string" } },
        "executables": { "type": "array", "items": { "type": "string" } },
        "reads": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
